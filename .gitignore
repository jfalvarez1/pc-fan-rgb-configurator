# runtime state - regenerated on every launch
sensors.json
manual_override.flag
claude_thinking.flag
claude_flags/
__pycache__/
*.pyc

# logs
*.log
scripts/*.log

# bundled third-party binaries (download them yourself, see README)
FanControl/
OpenRGB/
_downloads/

