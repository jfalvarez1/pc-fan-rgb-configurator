# evidence behind the curve tuning. Only the noisy rolling log is ignored.
scripts/thermal_log.csv
scripts/thermal_log_old.csv

# session output lives in data/ ; scripts/ copies are runtime artefacts
scripts/bench_*.csv
scripts/lhm_report.txt
scripts/mobo_fan_report.txt
scripts/probe_one.txt
scripts/pump_map.txt
